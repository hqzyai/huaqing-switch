ARG BASE_IMAGE=hqzy-open-design:ui-20261022-c79a52a
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.hqzyai.switch.integration="design-text-model-routing"
USER root
COPY --chmod=644 lib/index.js /opt/dsh/node_modules/@deepseek-ai/dsh-llm-pi-ai/lib/index.js
USER open-design
