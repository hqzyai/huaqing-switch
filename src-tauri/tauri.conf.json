{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huaqing Switch",
  "version": "0.1.0",
  "identifier": "app.hqmodelswitch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Huaqing Switch",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ixp8Fts9hzQzKZQLuki15bmj2eu9zf/Ma0a+YW9IKZk='; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/hq/32x32.png",
      "icons/hq/128x128.png",
      "icons/hq/128x128@2x.png",
      "icons/hq/icon.icns",
      "icons/hq/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "shortDescription": "Local model API connections for HQHarness",
    "resources": ["../LICENSE", "../UPSTREAM.md", "../brand.config.json"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hqmodelswitch"]
      }
    }
  }
}
