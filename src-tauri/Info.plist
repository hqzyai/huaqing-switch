<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Register this product's deep-link scheme independently from upstream. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Huaqing Switch Deep Link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>hqmodelswitch</string>
      </array>
    </dict>
  </array>

  <!-- macOS local-network privacy prompt for LAN API endpoints -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Huaqing Switch needs access to your local network to connect to local API endpoints.</string>
</dict>
</plist>
