<?xml version="1.0" encoding="utf-8"?>
<?if $(sys.BUILDARCH)="x86"?>
  <?define HqResourceWin64 = "no" ?>
<?else?>
  <?define HqResourceWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Directory Id="HqBundledResources" Name="_up_">
        <!-- Keep these component GUIDs stable across upgrades. -->
        <Component Id="HqLicenseResource" Guid="15F689FD-A9DB-464C-BF36-0B111C8514DD" Win64="$(var.HqResourceWin64)">
          <File Id="HqLicenseFile" Source="$(sys.SOURCEFILEDIR)..\..\LICENSE" KeyPath="no" />
          <RegistryValue Root="HKCU" Key="Software\app.hqmodelswitch.desktop\InstallerResources" Name="License" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveHqBundledResources" Directory="HqBundledResources" On="uninstall" />
        </Component>
        <Component Id="HqUpstreamResource" Guid="4898297D-D3AE-48EE-AD40-8F6765A5825E" Win64="$(var.HqResourceWin64)">
          <File Id="HqUpstreamFile" Source="$(sys.SOURCEFILEDIR)..\..\UPSTREAM.md" KeyPath="no" />
          <RegistryValue Root="HKCU" Key="Software\app.hqmodelswitch.desktop\InstallerResources" Name="Upstream" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="HqBrandResource" Guid="7E92D47B-DF44-438A-8DD2-F0F08EF43E91" Win64="$(var.HqResourceWin64)">
          <File Id="HqBrandFile" Source="$(sys.SOURCEFILEDIR)..\..\brand.config.json" KeyPath="no" />
          <RegistryValue Root="HKCU" Key="Software\app.hqmodelswitch.desktop\InstallerResources" Name="Brand" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </DirectoryRef>
    <ComponentGroup Id="HqPerUserResources">
      <ComponentRef Id="HqLicenseResource" />
      <ComponentRef Id="HqUpstreamResource" />
      <ComponentRef Id="HqBrandResource" />
    </ComponentGroup>
  </Fragment>
</Wix>
